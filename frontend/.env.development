# Local development API config:
# - Keep REACT_APP_API_BASE empty to use relative URLs from the frontend.
# - setupProxy forwards API routes to REACT_APP_DEV_PROXY_TARGET.
# Start backend first: cd backend && python -m uvicorn main:app --reload
REACT_APP_API_BASE=
REACT_APP_DEV_PROXY_TARGET=http://localhost:8000
