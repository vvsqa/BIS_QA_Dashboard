# Local development API config:
# - Keep REACT_APP_API_BASE empty to use relative URLs (works with proxy).
# - setupProxy.js forwards API routes to REACT_APP_DEV_PROXY_TARGET.
# Start backend first: cd backend && python -m uvicorn main:app --reload --port 8000
REACT_APP_API_BASE=
REACT_APP_DEV_PROXY_TARGET=http://127.0.0.1:8000
