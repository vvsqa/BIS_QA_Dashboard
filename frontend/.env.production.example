# Production / Hosted build – copy to .env.production and set values before npm run build
# All API calls from the frontend go to this URL (no trailing slash).

REACT_APP_API_BASE=https://your-backend-domain.com

# Example if backend is on same host with path:
# REACT_APP_API_BASE=https://app.example.com/api

# Example for local network hosting (replace with your server IP/hostname):
# REACT_APP_API_BASE=http://192.168.1.100:8000
