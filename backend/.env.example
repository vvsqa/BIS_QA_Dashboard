# BIS QA Dashboard – Backend environment template
# Copy to .env and fill in real values. Do not commit .env to the repo.

# ----- Database (required) -----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=qa_dashboard
DB_USER=postgres
DB_PASSWORD=your_secure_password
# Or set a full URL (overrides above):
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/qa_dashboard

# ----- Auth (required in production) -----
# Use a long random string (e.g. 32+ chars). Change from default for production.
JWT_SECRET_KEY=change-this-to-a-secure-random-string-in-production
CLIENT_DEFAULT_PASSWORD=BIS@123

# ----- PM Tracker API (required for ticket sync) -----
PM_API_URL=https://www.bissafety.app/rest/v.01/pm/ticket-export
PM_API_KEY=
PM_AUTO_SYNC=true
# Sync every 2 min for near real-time ticket updates (set 10+ to reduce API load)
PM_SYNC_INTERVAL_MINUTES=2

# ----- Redmine (required for bug sync) -----
REDMINE_URL=https://redmine.example.com
REDMINE_API_KEY=
REDMINE_AUTO_SYNC=true
# Sync every 2 min for near real-time bug updates (set 15+ to reduce API load)
REDMINE_SYNC_INTERVAL_MINUTES=2

# ----- Google Sheets (optional – leave empty to disable) -----
# SHEETS_AUTO_SYNC=false
# GOOGLE_CREDENTIALS_FILE=config/google_credentials.json
# QA_TIMESHEET_SHEET_ID=
# DEV_TIMESHEET_SHEET_ID=
# QA_SHEET_NAME=BIS - QA
# DEV_SHEET_NAME=Web

# ----- Logging -----
# PM_SYNC_LOGGING=true
