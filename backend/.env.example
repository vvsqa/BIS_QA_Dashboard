# Copy to .env and fill in values. Do not commit .env (it is in .gitignore).

# ===== PM Tracker API =====
# Legacy API (v1) - current default path used by backend unless PM_API_V2=true
PM_API_URL=https://www.bissafety.app/rest/v.01/pm/ticket-export
PM_API_KEY=your_pm_api_key_here

# New API (v2) - keep disabled until validated in your environment
PM_API_V2=false
PM_API_URL_V2=https://www.bissafety.app/rest/mcp.v1/pm/ticketlist
PM_API_KEY_V2=your_pm_bearer_token_here

# ===== Redmine (bug sync from https://redmine.bissafety.app) =====
# Base URL only (no /projects/... path).
REDMINE_URL=https://redmine.bissafety.app
# Project identifier from the URL, e.g. bis-web from .../projects/bis-web
REDMINE_PROJECT_IDS=bis-web
# Get from Redmine: My account → API access
REDMINE_API_KEY=your_redmine_api_key_here

# Optional: REDMINE_AUTO_SYNC=true (default), REDMINE_SYNC_INTERVAL_MINUTES=2

# ===== TestRail (test plans/runs/results – see TESTRAIL_DEVOPS.md) =====
TESTRAIL_URL=https://bistrainer.testrail.io
TESTRAIL_EMAIL=your_testrail_email@company.com
TESTRAIL_API_KEY=your_testrail_api_key_here
TESTRAIL_PROJECT_ID=14

# TestRail Automation Coverage Project (Project 18 - tracks automated vs manual cases)
# Run sync_automation_testrail.py to sync automation data
TESTRAIL_AUTOMATION_PROJECT_ID=18

# ===== Google Sheets (timesheet sync – see GOOGLE_SHEETS_DEVOPS.md) =====
# Auth: oauth2 (default) or service_account
GOOGLE_AUTH_METHOD=oauth2
# OAuth2: place oauth2_credentials.json and token.json in backend/config/
OAUTH2_CREDENTIALS_FILE=config/oauth2_credentials.json
OAUTH2_TOKEN_FILE=config/token.json
# Service account: place google_credentials.json in backend/config/
# GOOGLE_CREDENTIALS_FILE=config/google_credentials.json

# Sheet IDs from URL: https://docs.google.com/spreadsheets/d/{SHEET_ID}/edit
QA_TIMESHEET_SHEET_ID=your_qa_sheet_id_here
DEV_TIMESHEET_SHEET_ID=your_dev_sheet_id_here
QA_SHEET_NAME=BIS - QA
DEV_SHEET_NAME=Web

# Enable auto-sync when backend starts; interval in minutes
SHEETS_AUTO_SYNC=true
SHEETS_SYNC_INTERVAL=5
SHEETS_REALTIME_SYNC=true

# ===== Google Sheets EXPORT (exports PM & TestRail data TO Google Sheets) =====
# This exports your database data to a Google Sheet for external access
# Setup: Create service account, download JSON key, share sheet with service account email
SHEETS_EXPORT_CREDENTIALS_FILE=credentials/sheets_export_credentials.json
SHEETS_EXPORT_SPREADSHEET_ID=your_export_spreadsheet_id_here
SHEETS_EXPORT_AUTO_SYNC=true
# Export interval in minutes (default: 30, min: 5, max: 1440)
SHEETS_EXPORT_INTERVAL_MINUTES=30

# ===== Monthly Team Report (PDF) =====
# Scheduler runs on the LAST DAY of every month at MONTHLY_REPORT_HOUR:MINUTE
MONTHLY_REPORT_AUTO=true
MONTHLY_REPORT_HOUR=18
MONTHLY_REPORT_MINUTE=0

# ===== Email delivery for the Monthly Team Report =====
# Disabled by default. Turn on by setting MONTHLY_REPORT_EMAIL_ENABLED=true
# and filling in the SMTP and recipient settings below.
MONTHLY_REPORT_EMAIL_ENABLED=false
MONTHLY_REPORT_RECIPIENTS=manager@company.com,lead@company.com
# MONTHLY_REPORT_CC=optional_cc1@company.com

# SMTP settings - example for Gmail with an App Password.
# For Office365 use smtp.office365.com:587. For SMTPS use port 465 (no STARTTLS).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
# SMTP_FROM=your_email@gmail.com
# SMTP_FROM_NAME=QA Dashboard Reports
