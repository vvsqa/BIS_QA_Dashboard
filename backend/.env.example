# Copy to .env and fill in values. Do not commit .env (it is in .gitignore).

# ===== PM Tracker API =====
# Legacy API (v1) - current default path used by backend unless PM_API_V2=true
PM_API_URL=https://www.bissafety.app/rest/v.01/pm/ticket-export
PM_API_KEY=your_pm_api_key_here

# New API (v2) - keep disabled until validated in your environment
PM_API_V2=false
PM_API_URL_V2=https://www.bissafety.app/rest/mcp.v1/pm/ticketlist
PM_API_KEY_V2=your_pm_bearer_token_here

# ===== Redmine (bug sync from https://redmine.bissafety.app) =====
# Base URL only (no /projects/... path).
REDMINE_URL=https://redmine.bissafety.app
# Project identifier from the URL, e.g. bis-web from .../projects/bis-web
REDMINE_PROJECT_IDS=bis-web
# Get from Redmine: My account → API access
REDMINE_API_KEY=your_redmine_api_key_here

# Optional: REDMINE_AUTO_SYNC=true (default), REDMINE_SYNC_INTERVAL_MINUTES=2
